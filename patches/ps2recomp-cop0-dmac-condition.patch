+++ b/ps2xRuntime/include/runtime/ps2_cop0_condition.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+
+// CPCOND0: every channel selected by D_PCR.CPC must have D_STAT.CIS set.
+// D_STAT interrupt masks and D_PCR priority bits do not select channels here.
+template <class Memory>
+inline bool Ps2Cop0Condition(Memory &memory)
+{
+    const uint32_t status = memory.read32(0x1000E010u);
+    const uint32_t selected = memory.read32(0x1000E020u) & 0x3FFu;
+    return (status & selected) == selected;
+}
