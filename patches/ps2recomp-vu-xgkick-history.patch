 namespace
 {
+    struct XgkickHistoryConfig { bool enabled = false; uint32_t sourceQw = 108u; };
+    const XgkickHistoryConfig &xgkickHistoryConfig()
+    {
+        static const XgkickHistoryConfig config = [] {
+            XgkickHistoryConfig result;
+            const char *enabled = std::getenv("PS2_TRACE_VU_XGKICK_HISTORY");
+            if (!enabled || std::strcmp(enabled, "1") != 0) return result;
+            const char *source = std::getenv("PS2_TRACE_VU_XGKICK_SOURCE_QW");
+            if (source)
+            {
+                char *end = nullptr;
+                const unsigned long value = std::strtoul(source, &end, 10);
+                if (source == end || *end != '\0' || value > 1023u) return result;
+                result.sourceQw = static_cast<uint32_t>(value);
+            }
+            result.enabled = true;
+            return result;
+        }();
+        return config;
+    }
+    struct XgkickHistory
+    {
+        struct Step { uint64_t cycle=0; uint32_t pc=0, lower=0, upper=0; std::array<int32_t,16> vi{}; };
+        struct Store { uint64_t cycle=0; uint32_t pc=0, address=0; uint8_t mask=0; bool committed=false; std::array<uint32_t,4> words{}; };
+        const void *owner=nullptr;
+        uint64_t steps=0, stores=0, emissions=0;
+        std::array<Step,64> instruction{};
+        std::array<Store,32> store{};
+    };
+    XgkickHistory &xgkickHistory(const void *owner)
+    {
+        static thread_local XgkickHistory history;
+        if (history.owner != owner) { history = {}; history.owner = owner; }
+        return history;
+    }
+    void recordXgkickStep(const void *owner, uint64_t cycle, uint32_t pc,
+                          uint32_t lower, uint32_t upper, const int32_t *vi)
+    {
+        if (!xgkickHistoryConfig().enabled) return;
+        auto &history=xgkickHistory(owner);
+        auto &step=history.instruction[history.steps++ % history.instruction.size()];
+        step.cycle=cycle; step.pc=pc; step.lower=lower; step.upper=upper;
+        std::copy_n(vi,16,step.vi.begin());
+    }
+    void recordXgkickStore(const void *owner, uint64_t cycle, uint32_t pc, uint32_t address,
+                           const uint32_t *words, uint8_t mask, bool committed)
+    {
+        if (!xgkickHistoryConfig().enabled) return;
+        auto &history=xgkickHistory(owner);
+        auto &store=history.store[history.stores++ % history.store.size()];
+        store.cycle=cycle; store.pc=pc; store.address=address; store.mask=mask; store.committed=committed;
+        std::copy_n(words,4,store.words.begin());
+    }
+    void emitXgkickHistory(const void *owner, uint32_t sourceQw)
+    {
+        const auto &config=xgkickHistoryConfig();
+        if (!config.enabled || sourceQw != config.sourceQw) return;
+        auto &history=xgkickHistory(owner);
+        const auto sample=++history.emissions;
+        if (sample>4u && (sample & (sample-1u))!=0u) return;
+        std::fprintf(stderr,"[vu:xgkick-history] sample=%llu source_qw=%u steps=%llu stores=%llu\n",
+            static_cast<unsigned long long>(sample),sourceQw,
+            static_cast<unsigned long long>(history.steps),static_cast<unsigned long long>(history.stores));
+        const auto firstStep=history.steps>history.instruction.size()?history.steps-history.instruction.size():0u;
+        for (auto index=firstStep;index<history.steps;++index)
+        {
+            const auto &step=history.instruction[index % history.instruction.size()];
+            std::fprintf(stderr,"[vu:xgkick-step] sample=%llu cycle=%llu pc=0x%x lower=0x%08x upper=0x%08x vi=",
+                static_cast<unsigned long long>(sample),static_cast<unsigned long long>(step.cycle),step.pc,step.lower,step.upper);
+            for (const auto value:step.vi) std::fprintf(stderr,"%04x,",static_cast<unsigned>(value)&0xffffu);
+            std::fputc('\n',stderr);
+        }
+        const auto firstStore=history.stores>history.store.size()?history.stores-history.store.size():0u;
+        for (auto index=firstStore;index<history.stores;++index)
+        {
+            const auto &store=history.store[index % history.store.size()];
+            std::fprintf(stderr,"[vu:xgkick-store] sample=%llu phase=%s cycle=%llu pc=0x%x address=0x%x mask=0x%x words=%08x,%08x,%08x,%08x\n",
+                static_cast<unsigned long long>(sample),store.committed?"commit":"issue",
+                static_cast<unsigned long long>(store.cycle),store.pc,store.address,store.mask,
+                store.words[0],store.words[1],store.words[2],store.words[3]);
+        }
+    }
