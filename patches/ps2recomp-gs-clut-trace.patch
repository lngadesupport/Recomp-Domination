 namespace
 {
+    bool matchesClutTraceBase(uint32_t cbp)
+    {
+        static const int filter = []() {
+            const char *text = std::getenv("PS2_TRACE_GS_CLUT_CBP");
+            if (!text) return -1;
+            if (!*text) return -2;
+            uint32_t value = 0;
+            for (; *text; ++text)
+            {
+                if (*text < '0' || *text > '9') return -2;
+                value = value * 10u + static_cast<uint32_t>(*text - '0');
+                if (value > 0x3FFFu) return -2;
+            }
+            return static_cast<int>(value);
+        }();
+        return filter == -1 || filter == static_cast<int>(cbp);
+    }
