diff --git a/ps2xRuntime/include/runtime/ps2_intro_skip.h b/ps2xRuntime/include/runtime/ps2_intro_skip.h
new file mode 100644
index 0000000..34865eb
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_intro_skip.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+// Only the first decoded movie after runtime reset; no synthetic EOF or PC jump.
+struct PS2IntroSkip {
+    std::atomic<int64_t> first{-1}, latest{-1};
+    void reset() { first.store(-1); latest.store(-1); }
+    void frame(int64_t now) {
+        int64_t unset = -1;
+        first.compare_exchange_strong(unset, now);
+        latest.store(now);
+    }
+    bool start(int64_t now) const {
+        const auto begin = first.load(), last = latest.load();
+        return begin >= 0 && now >= begin && now >= last &&
+               now - last <= 300 && now - begin < 12000 &&
+               (now - begin) % 1000 < 200;
+    }
+};
+inline PS2IntroSkip ps2IntroSkip;
+inline int64_t ps2IntroSkipNow() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline bool ps2IntroSkipEnabled() {
+    static const bool enabled = [] { const char* v = std::getenv("PS2_DOWNHILL_AUTO_SKIP_INTRO");
+        return v && v[0] == '1' && v[1] == '\0'; }();
+    return enabled;
+}
