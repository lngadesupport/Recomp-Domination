 namespace
 {
+    bool traceTriangleTexture(const GSDrawState &state)
+    {
+        static const int filter = []() {
+            const char *text = std::getenv("PS2_TRACE_GS_TRIANGLE_TBP");
+            if (!text || !*text) return -1;
+            uint32_t value = 0;
+            for (; *text; ++text)
+            {
+                if (*text < '0' || *text > '9') return -1;
+                value = value * 10u + static_cast<uint32_t>(*text - '0');
+                if (value > 0x3FFFu) return -1;
+            }
+            return static_cast<int>(value);
+        }();
+        return filter >= 0 && state.prim.tme &&
+            (state.prim.type == GS_PRIM_TRIANGLE || state.prim.type == GS_PRIM_TRISTRIP || state.prim.type == GS_PRIM_TRIFAN) &&
+            state.context.tex0.tbp0 == static_cast<uint32_t>(filter);
+    }
+
+    bool traceSample(uint64_t sequence, uint64_t initial)
+    {
+        return sequence <= initial || (sequence & (sequence - 1u)) == 0u;
+    }
