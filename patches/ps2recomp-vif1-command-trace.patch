diff --git a/ps2xRuntime/include/runtime/ps2_vif1_trace.h b/ps2xRuntime/include/runtime/ps2_vif1_trace.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_vif1_trace.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstdio>
+struct Vif1CommandTrace {
+    struct Entry { uint64_t sequence; uint32_t code, offset, packetBytes; };
+    std::array<Entry, 64> entries{};
+    uint64_t sequence{};
+    void record(uint32_t code, uint32_t offset, uint32_t packetBytes) {
+        const uint64_t current=++sequence;
+        entries[(current-1)%entries.size()]={current,code,offset,packetBytes};
+    }
+    void dump(const char *reason) const {
+        std::fprintf(stderr,"[vif1:recent] reason=%s sequence=%llu\n",reason,
+            static_cast<unsigned long long>(sequence));
+        const uint64_t first=sequence>entries.size() ? sequence-entries.size()+1 : 1;
+        for(uint64_t i=first;i<=sequence;++i) {
+            const auto &entry=entries[(i-1)%entries.size()];
+            std::fprintf(stderr,"[vif1:command] sequence=%llu code=0x%08x offset=%u packet_bytes=%u\n",
+                static_cast<unsigned long long>(entry.sequence),entry.code,entry.offset,entry.packetBytes);
+        }
+    }
+};
