diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -2211,6 +2211,21 @@
 
 bool PS2Runtime::eeCheckpointDue(uint32_t cycles) noexcept
 {
+    // EE-thread diagnostic only: preserve guest state and the scheduler decision.
+    static const bool traceVif = std::getenv("PS2_TRACE_VIF1_COMMANDS") != nullptr;
+    if (traceVif) {
+        const R5900Context *context = m_eeScheduler->currentContext();
+        const auto &recent = m_memory.vif1_command_trace;
+        if (context && context->pc == 0x1B4648u && recent.sequence != m_lastVif1TraceSequence) {
+            m_lastVif1TraceSequence = recent.sequence;
+            const auto &vu = m_vu1.state();
+            std::fprintf(stderr, "[vif1:wait] pc=0x%08x vif_stat=0x%08x gif_stat=0x%08x vu_pc=0x%08x vu_cycles=%llu vu_run_cycles=%llu ended_by_e=%u stopped_d=%u stopped_t=%u\n",
+                context->pc, m_memory.vif1_regs.stat, m_memory.read32(0x10003020u), vu.pc,
+                static_cast<unsigned long long>(vu.cycles), static_cast<unsigned long long>(vu.lastRunCycles),
+                unsigned(vu.lastRunEndedByE), unsigned(vu.stoppedByD), unsigned(vu.stoppedByT));
+            recent.dump("downhill-queue-wait");
+        }
+    }
     return m_eeScheduler->checkpointDue(cycles);
 }
 
