diff --git a/ps2xIOP/include/ps2x/iop/cdvd_iso_lookup.h b/ps2xIOP/include/ps2x/iop/cdvd_iso_lookup.h
new file mode 100644
index 0000000..40a1ebd
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/cdvd_iso_lookup.h
@@ -0,0 +1,83 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ps2x::iop
+{
+// Reader(offset, destination, bytes) must return true only for an exact read.
+// Both EE SDK and IOP cdvdman use this lookup when a physical ISO is mounted.
+template <typename Reader>
+bool lookupIsoFile(std::string_view path, Reader read, uint32_t &lsn, uint32_t &size)
+{
+    const auto le32 = [](const uint8_t *p) {
+        return uint32_t(p[0]) | (uint32_t(p[1]) << 8) |
+               (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+    };
+    const auto normalize = [](std::string text) {
+        const auto version = text.find(';');
+        if (version != std::string::npos) text.resize(version);
+        for (char &c : text) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+        return text;
+    };
+    lsn = size = 0u;
+    std::array<uint8_t, 2048u> descriptor{};
+    bool primary = false;
+    for (uint32_t sector = 16u; sector < 80u; ++sector)
+    {
+        if (!read(uint64_t(sector) * 2048u, descriptor.data(), descriptor.size())) return false;
+        if (std::string_view(reinterpret_cast<const char *>(descriptor.data() + 1u), 5u) != "CD001" || descriptor[6] != 1u)
+            return false;
+        if (descriptor[0] == 1u) { primary = true; break; }
+        if (descriptor[0] == 255u) return false;
+    }
+    if (!primary || descriptor[156] < 34u) return false;
+    uint32_t extent = le32(descriptor.data() + 158u);
+    uint32_t length = le32(descriptor.data() + 166u);
+    std::string cleaned(path);
+    if (const auto colon = cleaned.find(':'); colon != std::string::npos) cleaned.erase(0, colon + 1u);
+    std::replace(cleaned.begin(), cleaned.end(), '\\', '/');
+    size_t begin = 0u;
+    bool directory = true;
+    while (begin < cleaned.size())
+    {
+        const auto end = cleaned.find('/', begin);
+        const std::string component = cleaned.substr(begin, end == std::string::npos ? end : end - begin);
+        begin = end == std::string::npos ? cleaned.size() : end + 1u;
+        if (component.empty() || component == ".") continue;
+        if (component == ".." || !directory || length == 0u || length > 32u * 1024u * 1024u) return false;
+        std::vector<uint8_t> bytes(length);
+        if (!read(uint64_t(extent) * 2048u, bytes.data(), bytes.size())) return false;
+        const std::string wanted = normalize(component);
+        bool found = false;
+        for (size_t pos = 0u; pos < bytes.size();)
+        {
+            const uint32_t recordLength = bytes[pos];
+            if (recordLength == 0u) { pos = (pos / 2048u + 1u) * 2048u; continue; }
+            if (recordLength < 34u || recordLength > bytes.size() - pos ||
+                recordLength > 2048u - pos % 2048u) return false;
+            const uint8_t *record = bytes.data() + pos;
+            const uint32_t nameLength = record[32];
+            if (nameLength > recordLength - 33u) return false;
+            if (nameLength && record[33] > 1u && normalize(std::string(reinterpret_cast<const char *>(record + 33u), nameLength)) == wanted)
+            {
+                if ((record[25] & 0x80u) != 0u || record[1] != 0u) return false; // unsupported multi-extent/XAR
+                extent = le32(record + 2u);
+                length = le32(record + 10u);
+                directory = (record[25] & 2u) != 0u;
+                found = true;
+                break;
+            }
+            pos += recordLength;
+        }
+        if (!found) return false;
+    }
+    lsn = extent;
+    size = length;
+    return true;
+}
+}
