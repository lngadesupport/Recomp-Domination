#include "ps2_runtime.h"
#include "ps2_runtime_macros.h"
#include <vector>
#include <cmath>
#include <cstring>
#include <fstream>
#include <limits>
#include <iostream>
@GENERATED_INCLUDES@
int main() {
 PS2Runtime runtime;
@GENERATED_REGISTRATION@
 std::vector<uint8_t> original(PS2_RAM_SIZE);
 std::ifstream in(@ELF_PATH@,std::ios::binary); std::vector<uint8_t> elf((std::istreambuf_iterator<char>(in)),{});
 uint32_t phoff;uint16_t count; std::memcpy(&phoff,elf.data()+28,4);std::memcpy(&count,elf.data()+44,2);
 for(unsigned n=0;n<count;++n) { uint32_t ph[8];std::memcpy(ph,elf.data()+phoff+n*32,32);if(ph[0]==1) std::memcpy(original.data()+ph[2],elf.data()+ph[1],ph[4]); }
 const float xyz[]={3.0f,-4.0f,0.0f};const float multiplier=1.0f;
 std::memcpy(original.data()+0x34180,xyz,12);std::memcpy(original.data()+0x29dd88,&multiplier,4);
 const uint32_t vectorBase=0x30000, flagBase=0x50000;
 std::memcpy(original.data()+0x21164,&vectorBase,4);std::memcpy(original.data()+0x20f24,&flagBase,4);
 using Fn=void(*)(uint8_t*,R5900Context*,PS2Runtime*);
 Fn variants[]={oldNumericBody,sub_00177DA0_0x177da0};
 for(unsigned n=0;n<2;++n) {
  auto ram=original;R5900Context c{};c.pc=0x177da0;SET_GPR_U32(&c,4,0x20000);SET_GPR_U32(&c,29,0x10000);SET_GPR_U32(&c,31,0x123456);SET_GPR_U32(&c,16,0x11223344);SET_GPR_U32(&c,17,0x55667788);
  variants[n](ram.data(),&c,&runtime);
  std::cout << "variant="<<(n?"corrected":"old-SQRT-operand")<<" pc="<<std::hex<<c.pc<<" ra="<<GPR_U64((&c),31)<<" s0="<<GPR_U64((&c),16)<<" s1="<<GPR_U64((&c),17)<<" sp="<<GPR_U32((&c),29)<<std::dec<<" root="<<c.f[4]<<" formatted=";
  for(unsigned i=0;i<40&&ram[0xffd0+i];++i)std::cout<<char(ram[0xffd0+i]);std::cout<<'\n';
  if(!n && (c.pc!=0x30303030 || GPR_U64((&c),31)!=0x3030303030303030ull || !std::isnan(c.f[4]))) return 2;
  if(n && (c.pc!=0x123456 || GPR_U32((&c),29)!=0x10000 || GPR_U32((&c),16)!=0x11223344 || GPR_U32((&c),17)!=0x55667788))return 1;
 }
}
